# ─── Database ─────────────────────────────────────
DATABASE_URL="postgresql://vealbiz_user:vealbiz_password@localhost:5432/vealbiz"

# Security keys (change these in production!)
JWT_SECRET="change-me-to-a-long-random-secret"
REFRESH_TOKEN_SECRET="change-me-to-another-long-random-secret"

# Groq AI API key
GROQ_API_KEY="gsk_your_key_from_groq_console"

# Server settings
PORT=8000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# File upload settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# ─── SMTP (required for email verification + team invites) ────────────────────
# Use a Gmail App Password — NOT your regular Google password.
# Setup: myaccount.google.com → Security → 2-Step Verification → App passwords
#
# Alternative providers:
#   Mailgun:  SMTP_HOST=smtp.mailgun.org  PORT=587
#   Resend:   SMTP_HOST=smtp.resend.com   PORT=465  USER=resend  PASS=re_your_api_key
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="windvealtech@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="windvealtech@gmail.com"
SMTP_FROM_NAME="VealBiz"

# ─── OAuth — Google ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: http://localhost:8000/api/auth/google/callback
#    (use your deployed API URL in production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OAuth — Microsoft ─────────────────────────────────────────────────────────
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations
# 2. Register a new app, set redirect URI: http://localhost:8000/api/auth/microsoft/callback
# 3. Under "Certificates & secrets" create a client secret
# MICROSOFT_TENANT_ID: use "common" to allow any Microsoft account, or your tenant ID
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Public URLs (used for OAuth redirect URIs and email links)
API_URL="http://localhost:8000"

# ─── Super Admin account (platform-level, created by seed) ────────────────────
# This account has access to the /admin panel and all organisations.
# Change all of these before deploying!
SUPER_ADMIN_EMAIL="admin@vealbiz.com"
SUPER_ADMIN_USERNAME="vealbiz.admin"
SUPER_ADMIN_FIRST_NAME="VealBiz"
SUPER_ADMIN_LAST_NAME="Admin"
SUPER_ADMIN_PASSWORD="SuperAdmin123!"

# ─── Optional test / default org-admin (only created when email is set) ───────
# Useful for local development so you can log in as a normal org user.
# Remove or leave empty in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_ORG_NAME="My Company"
SEED_ADMIN_ORG_SLUG="my-company"
