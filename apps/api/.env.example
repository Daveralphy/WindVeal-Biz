WINDVEAL_DATABASE_URL=postgres://windveal:windveal@localhost:5433/windveal
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
SITE_URL=http://localhost:5174
API_PORT=4000
STORAGE_DIR=./storage

# ---------------- Veal (WindVeal AI) ----------------
# Veal works with any AI service that uses the standard "chat completions" format (almost all of them do).
# Only these lines decide which one; nothing in the code names a provider, so moving to another service,
# or to your own model later, means changing these lines and restarting the API.
# Leave them empty and Veal shows as "not switched on"; everything else in WindVeal works as normal.
#
#   AI_BASE_URL   the service's address (see the examples)
#   AI_MODEL      the model's name, exactly as the service lists it
#   AI_API_KEY    your secret key from the service. Keep it only in .env, never in code or git.
#   AI_EXTRA_BODY optional JSON added to every request, for a service's own settings (e.g. {"temperature": 0.2})
#   AI_TIMEOUT_SECONDS optional (default 120)
#
# Grok (xAI), key from console.x.ai:        AI_BASE_URL=https://api.x.ai/v1
# OpenAI, key from platform.openai.com:     AI_BASE_URL=https://api.openai.com/v1
# Groq, key from console.groq.com:          AI_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek, key from platform.deepseek.com: AI_BASE_URL=https://api.deepseek.com/v1
# OpenRouter (many models, one key):        AI_BASE_URL=https://openrouter.ai/api/v1
# Your own model, later:                    AI_BASE_URL=https://your-model-server.example.com/v1
#
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
