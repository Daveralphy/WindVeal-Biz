WINDVEAL_DATABASE_URL=postgres://windveal:windveal@localhost:5433/windveal
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
SITE_URL=http://localhost:5174
API_PORT=4000
STORAGE_DIR=./storage

# ---------------- Veal (WindVeal AI) ----------------
# Veal works with any AI model. Only these lines decide which one; nothing in the code names a provider,
# so moving to another model (or your own, later) means changing these lines and restarting the API.
# Leave AI_MODEL empty and Veal shows as "not switched on"; everything else in WindVeal works as normal.
#
#   AI_FORMAT     openai     = the standard "chat completions" format (OpenAI, xAI Grok, Groq, OpenRouter,
#                              Together, Ollama, vLLM, llama.cpp and most self-hosted models). The default.
#                 anthropic  = Anthropic's own API, for Claude.
#   AI_BASE_URL   where the model is (see the examples). Not needed for Anthropic.
#   AI_MODEL      the model's name, exactly as the provider lists it.
#   AI_API_KEY    your secret key from the provider. Keep it only in .env, never in code or git.
#   AI_EXTRA_BODY optional JSON added to every request, for a provider's own settings.
#   AI_MAX_TOKENS optional, longest reply in tokens (default 16000).
#   AI_TIMEOUT_SECONDS optional (default 120).
#   AI_FALLBACKS  optional, Anthropic only: "off" stops a declined request being re-run on another Claude model.
#
# Claude (Anthropic) - key from console.anthropic.com:
# AI_FORMAT=anthropic
# AI_MODEL=claude-opus-5-5          (or claude-sonnet-5-5, or claude-haiku-5-5 for cheaper and faster)
# AI_API_KEY=sk-ant-...
# AI_EXTRA_BODY={"output_config": {"effort": "low"}}   (quicker everyday answers; leave out for the model's default)
#
# OpenAI - key from platform.openai.com:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<a model name from platform.openai.com/docs/models>
# AI_API_KEY=sk-...
#
# Grok (xAI) - key from console.x.ai:
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=<a model name from docs.x.ai>
# AI_API_KEY=xai-...
#
# Your own model, later (any server with the standard format):
# AI_BASE_URL=https://your-model-server.example.com/v1
# AI_MODEL=<your model's name>
# AI_API_KEY=<the key your server checks>
