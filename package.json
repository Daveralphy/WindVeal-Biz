{
  "name": "windveal-biz",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @windveal/api --filter @windveal/web --filter @windveal/site dev",
    "dev:api": "pnpm --filter @windveal/api dev",
    "dev:web": "pnpm --filter @windveal/web dev",
    "dev:site": "pnpm --filter @windveal/site dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @windveal/api db:push",
    "db:seed": "pnpm --filter @windveal/api db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "test:e2e": "node e2e/prepare.mjs && playwright test -c e2e/playwright.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "postgres": "^3.4.9"
  }
}
